{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Brutus",
  "version": "0.1.0",
  "identifier": "app.brutus.desktop",
  "build": { "frontendDist": "../ui" },
  "app": {
    "withGlobalTauri": true,
    "windows": [{
      "title": "Brutus",
      "width": 1180,
      "height": 800,
      "minWidth": 640,
      "minHeight": 560,
      "backgroundColor": "#101210"
    }],
    "security": {
      "csp": "default-src 'self'; script-src 'self'; style-src 'self'; img-src 'self' data:; connect-src ipc: http://ipc.localhost"
    }
  },
  "bundle": { "active": true, "targets": "all", "icon": ["icons/icon.png", "icons/icon.ico", "icons/icon.icns"] }
}
